# Environment Mode (development, test, production)
NODE_ENV=development

# Server Port
PORT=3001

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apishield?schema=public

# Redis Connection URL (Rate Limiting Engine)
REDIS_URL=redis://localhost:6379

# Session JWT Signing Key (Minimum 16 characters)
JWT_SECRET=apishield_dev_super_secret_session_key_2026
